# ──────────────────────────────────────────────────────────────
# Loyalty Card — variables para DESARROLLO LOCAL
# Copiar a .env. Para la VM usar .env.prod.example.
# NUNCA commitear valores reales.
# ──────────────────────────────────────────────────────────────

# ── Puertos ────────────────────────────────────────────────────
HTTP_PORT=8090
DB_EXPOSED_PORT=3307

# ── Perfil (local) ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Base de datos local ────────────────────────────────────────
MYSQL_DATABASE=loyalty_db
MYSQL_USER=loyalty_user
MYSQL_PASSWORD=loyalty_dev
MYSQL_ROOT_PASSWORD=root_dev_password
TZ=America/Argentina/Buenos_Aires

# Para correr el backend fuera de Docker (scripts/run-local.ps1)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/loyalty_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=loyalty_user
SPRING_DATASOURCE_PASSWORD=loyalty_dev

# ── JWT (dev) ──────────────────────────────────────────────────
APP_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
APP_JWT_EXPIRATION=86400000

# ── CORS local ─────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8090

# ── Bootstrap del PLATFORM_ADMIN ───────────────────────────────
APP_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@loyalty.local
APP_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=admin123
