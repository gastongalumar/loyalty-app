# ──────────────────────────────────────────────────────────────
# Loyalty Card — variables de entorno (copiar a .env)
# NUNCA commitear valores reales.
# ──────────────────────────────────────────────────────────────

# Perfil de Spring: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Base de datos
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/loyalty_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=loyalty_user
SPRING_DATASOURCE_PASSWORD=cambia-esta-clave

# JWT (mínimo 32 bytes UTF-8)
APP_JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-32-caracteres-o-mas
APP_JWT_EXPIRATION=86400000

# CORS: lista separada por comas
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Bootstrap del PLATFORM_ADMIN (idempotente; vacío = no crear)
APP_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@loyalty.local
APP_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=cambia-esta-clave-admin

# Docker Compose — MySQL
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_DATABASE=loyalty_db
MYSQL_USER=loyalty_user
MYSQL_PASSWORD=cambia-esta-clave

# Frontend (build de producción: ruta relativa /api servida por nginx)
