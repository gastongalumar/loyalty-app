# ──────────────────────────────────────────────────────────────
# Loyalty Card — variables de PRODUCCIÓN (VM)
# Copiar a .env en la VM y completar los secretos.
# NUNCA commitear este archivo con valores reales.
# ──────────────────────────────────────────────────────────────

# ── Puerto publicado en el host (reverse proxy -> 127.0.0.1:8090) ──
HTTP_PORT=8090

# ── Perfil ─────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Base de datos (solo red interna de Docker) ─────────────────
MYSQL_DATABASE=loyalty_db
MYSQL_USER=loyalty_user
MYSQL_PASSWORD=CAMBIAR_CLAVE_LARGA
MYSQL_ROOT_PASSWORD=CAMBIAR_ROOT_LARGA
TZ=America/Argentina/Buenos_Aires

# ── JWT ────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
APP_JWT_SECRET=CAMBIAR_SECRETO_DE_32_BYTES_O_MAS
APP_JWT_EXPIRATION=86400000

# ── CORS ───────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=https://loyalty.programandos.site

# ── Bootstrap del PLATFORM_ADMIN (solo la primera vez) ─────────
APP_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@loyalty.local
APP_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=CAMBIAR_CLAVE_ADMIN
